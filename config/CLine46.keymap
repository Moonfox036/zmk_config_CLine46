#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <behaviors/runtime_macro.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

/ {
    combos {
        compatible = "zmk,combos";

        Mouse-L {
            bindings = <&mkp LCLK>;
            key-positions = <19 20>;
        };

        Mouse-R {
            bindings = <&mkp RCLK>;
            key-positions = <20 21>;
        };

        L_Alt+L_Arrow {
            bindings = <&kp LA(LEFT_ARROW)>;
            key-positions = <31 32>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Default_Layer0 {
            bindings = <
&lt 4 ESC   &kp Q             &kp W     &kp E     &kp R               &kp T                                     &kp Y     &kp U  &kp I      &kp O           &kp LEFT_CONTROL  &kp DEL
&kp TAB     &lt 4 A           &kp S     &kp D     &kp F               &kp G                                     &kp H     &kp J  &kp K      &kp L           &kp P             &lt 6 MINUS
&kp LSHIFT  &kp Z             &kp X     &kp C     &kp V               &kp B                                     &kp N     &kp M  &kp COMMA  &kp DOT         &mo 3             &kp RSHIFT
            &kp LEFT_CONTROL  &kp LGUI  &kp LALT  &lt 6 INT_MUHENKAN  &lt 0 SPACE  &lt 2 INT_HENKAN    &kp RET  &kp BSPC                    &kp LEFT_ARROW  &kp RIGHT_ARROW
            >;
        };

        Symbol_Layer1 {
            bindings = <
&trans  &none   &none   &none          &none             &none                               &kp INT_YEN    &kp LS(NUMBER_7)  &kp LS(NUMBER_8)  &kp LS(NUMBER_9)  &kp RBKT                 &kp NON_US_HASH
&trans  &none   &none   &kp SEMICOLON  &kp SINGLE_QUOTE  &kp LEFT_BRACKET                    &kp LBKT       &kt LS(NUMBER_4)  &kp LS(NUMBER_5)  &kp LS(NUMBER_6)  &kp LS(INTERNATIONAL_1)  &kp LS(MINUS)
&trans  &none   &none   &none          &none             &none                               &kp LS(SLASH)  &kp LS(NUMBER_1)  &kp LS(NUMBER_2)  &kp LS(NUMBER_3)  &kp LS(ESCAPE)           &kp EQUAL
        &trans  &trans  &trans         &trans            &trans            &trans    &trans  &trans                                             &trans            &trans
            >;
        };

        Func_Sc_Layer2 {
            bindings = <
&trans  &kp LEFT_GUI      &kp F7  &kp F8  &kp F9  &kp F10                     &kp LC(Y)  &kp LC(C)       &kp LC(V)       &kp LC(X)        &kp LC(P)  &kp PAUSE_BREAK
&trans  &kp LEFT_ALT      &kp F4  &kp F5  &kp F6  &kp F11                     &kp LC(Z)  &mkp MB1        &kp UP_ARROW    &mkp MB2         &kp LC(F)  &kp LC(S)
&trans  &kp LEFT_CONTROL  &kp F1  &kp F2  &kp F3  &kp F12                     &kp LC(A)  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &trans     &kp PRINTSCREEN
        &trans            &trans  &trans  &trans  &trans   &trans    &kp RET  &kp BSPC                                   &kp HOME         &kp END
            >;
        };

        Device_Layer3 {
            bindings = <
&bt BT_CLR      &trans  &trans        &trans        &sys_reset    &bootloader                            &bootloader  &sys_reset  &trans  &trans  &trans  &trans
&bt BT_CLR_ALL  &trans  &bt BT_SEL 4  &trans        &trans        &trans                                 &trans       &trans      &trans  &trans  &trans  &trans
&trans          &trans  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &trans                                 &trans       &trans      &trans  &trans  &trans  &trans
                &trans  &bt BT_SEL 0  &trans        &trans        &trans       &trans    &studio_unlock  &trans                           &trans  &trans
            >;
        };

        Number_Layer4 {
            bindings = <
&trans  &kp LANGUAGE_2  &kp LANGUAGE_1  &trans  &trans  &trans                    &none       &kp KP_N7  &kp KP_N8  &kp KP_N9  &kp KP_SLASH     &kp KP_NUMLOCK
&trans  &trans          &trans          &trans  &trans  &trans                    &kp KP_N0   &kp KP_N4  &kp KP_N5  &kp KP_N6  &kp KP_PLUS      &kp KP_MINUS
&trans  &trans          &trans          &trans  &trans  &trans                    &kp KP_DOT  &kp KP_N1  &kp KP_N2  &kp KP_N3  &kp KP_ASTERISK  &kp KP_ENTER
        &trans          &trans          &trans  &trans  &trans  &trans    &trans  &trans                            &trans     &trans
            >;
        };

        Brank_Layer5 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans                  &trans  &trans
            >;
        };

        Mouse_Layer6 {
            bindings = <
&trans     &kp LEFT_WIN  &kp HOME  &kp UP    &kp END    &trans                           &trans  &trans     &kp LG(D)  &mkp MCLK  &trans   &kp K_APP
&kp LCTRL  &kp LALT      &kp LEFT  &kp DOWN  &kp RIGHT  &kp LG(E)                        &trans  &mkp LCLK  &kp UP     &mkp RCLK  &trans   &kp PG_UP
&trans     &trans        &trans    &trans    &kp LG(P)  &kp LS(LG(S))                    &trans  &kp LEFT   &kp DOWN   &kp RIGHT  &trans   &kp PG_DN
           &trans        &trans    &trans    &trans     &trans         &trans    &trans  &trans                        &kp HOME   &kp END
            >;
        };
    };
};
